package com.grillpoet.mixy

import android.graphics.Color
import android.os.Bundle
import androidx.activity.ComponentActivity
import androidx.activity.SystemBarStyle
import androidx.activity.compose.setContent
import androidx.activity.enableEdgeToEdge
import androidx.compose.foundation.layout.fillMaxSize
import androidx.compose.material3.MaterialTheme
import androidx.compose.material3.Surface
import androidx.compose.ui.Modifier
import com.grillpoet.mixy.ui.AppRoot
import com.grillpoet.mixy.ui.theme.MixyTheme
class MainActivity : ComponentActivity() {

    private val externalUri = MutableStateFlow<Uri?>(null)

    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)
        externalUri.value = extractViewUri(intent)

        setContent {
            MixyTheme {
                AppRoot(externalUri = externalUri)
            }
        }
    }

    override fun onNewIntent(intent: Intent) {
        super.onNewIntent(intent)
        setIntent(intent)
        externalUri.value = extractViewUri(intent)
    }

    /** 从外部 Intent 中提取可播放/查看的 URI */
    private fun extractViewUri(intent: Intent?): Uri? {
        if (intent == null) return null
        if (intent.action != Intent.ACTION_VIEW) return null
        return intent.data
    }
}